# CSES Cloud V3 · 环境变量示例
#
# 用法：
#   1. 复制本文件为仓库根的 `.env`（`.env` 已在 .gitignore 中，**绝不会入库**）；
#   2. 按需填写下面的值；
#   3. 服务启动时 server/lib/env-load.js 会自动加载 `.env`（不覆盖已存在的真实环境变量）。
#
# 生产环境推荐不落盘：用 systemd 的 Environment= / EnvironmentFile=、pm2 的 ecosystem
# env、或面板的环境变量注入。**任何密钥都不要提交进 git，也不要写进 server-config.js。**

# ─────────────────────────── 基础运行 ───────────────────────────
# 监听地址与端口（默认 0.0.0.0:8000）
HOST=0.0.0.0
PORT=8000

# ────────────────────── 临时管理员（admin 面板入口） ──────────────────────
# 是否启用临时管理员模式（1/0）。留空时：配置了密码哈希即启用。
TEMP_ADMIN_ENABLED=1
# 临时管理员用户名（默认 admin）
TEMP_ADMIN_USERNAME=admin
# 临时管理员密码哈希（bcrypt）。生成方式：
#   node -e "console.log(require('bcryptjs').hashSync('你的密码', 12))"
# 开发模式（项目根存在 debug.flag）且未配置该项时，默认账号为 admin / admin；
# 生产环境必须配置，否则临时管理员无法登录。
TEMP_ADMIN_PASSWORD_HASH=

# ─────────────────────── 智教联盟 OAuth2 SSO ───────────────────────
ALLIANCE_OAUTH_ENABLED=1
ALLIANCE_OAUTH_CLIENT_ID=
ALLIANCE_OAUTH_CLIENT_SECRET=
# 回调地址留空时按请求 origin 自动推导为 {origin}/api/auth/alliance-callback
ALLIANCE_OAUTH_REDIRECT_URI=
# 端点为联盟固定地址，一般不用改
# ALLIANCE_OAUTH_AUTHORIZE_URL=https://auth.smart-teach.cn/login/oauth/authorize
# ALLIANCE_OAUTH_TOKEN_URL=https://auth.smart-teach.cn/api/login/oauth/access_token
# ALLIANCE_OAUTH_USERINFO_URL=https://auth.smart-teach.cn/api/userinfo
# ALLIANCE_OAUTH_SCOPE=openid profile email

# ─────────────────────────── AI 默认模型 ───────────────────────────
AI_DEFAULT_MODEL=DeepSeek

# ───────────────────── 生产端同步（可选，默认关闭） ─────────────────────
# 设为 1 才启用 /api/system/update 管理接口与 scripts/sync-production.mjs 的写操作
UPDATE_SYNC_ENABLED=0
# 管理接口调用凭据（POST 时校验，建议 32 位以上随机串）：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
UPDATE_SYNC_TOKEN=
# 上游仓库与分支（默认即本仓库 V3 默认分支）
UPDATE_REPO=SmartTeachCN/CSESCloud
UPDATE_BRANCH=CSES-Cloud-V3
# 可选：GitHub Token，仅用于访问私有仓库或提高 API 限流额度
UPDATE_GITHUB_TOKEN=
# 生产代码目录（默认 = 仓库根）
UPDATE_INSTALL_DIR=
# 备份 / 日志 / 临时目录（默认都在 data/update/ 下）
UPDATE_BACKUP_DIR=
UPDATE_LOG_DIR=
UPDATE_TMP_DIR=
# 保留最近几份备份（默认 3）
UPDATE_MAX_BACKUPS=3
# 更新后重启服务的命令，例如：
#   pm2:    pm2 restart cses-cloud
#   systemd: systemctl restart cses-cloud
UPDATE_RESTART_CMD=
# 更新后是否重装依赖（默认 pnpm install --frozen-lockfile）
UPDATE_INSTALL_CMD=
# 健康检查地址（默认 http://127.0.0.1:<PORT>/api/system/health）
UPDATE_HEALTHCHECK_URL=
UPDATE_HEALTHCHECK_TIMEOUT_MS=120000
UPDATE_HEALTHCHECK_INTERVAL_MS=2000
# 更新时额外保留、绝不覆盖的顶层名字（逗号分隔，data/node_modules 等已内置保留）
UPDATE_PRESERVE=
# GitHub API 地址（一般不用改，企业代理时可用）
UPDATE_API_BASE=https://api.github.com
