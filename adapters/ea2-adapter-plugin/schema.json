{
  "type": "object",
  "properties": {
    "serverUrl": {
      "type": "string",
      "default": "http://127.0.0.1:8000",
      "description": "CSES Cloud 服务器地址"
    },
    "enrollmentCode": {
      "type": "string",
      "default": "",
      "description": "连接码（在 CSES Cloud 实例详情 → 设备控制中生成）"
    },
    "instanceUid": {
      "type": "string",
      "default": "",
      "description": "实例 UID（首次连接后自动填充）"
    },
    "credential": {
      "type": "string",
      "default": "",
      "description": "设备凭证（首次注册后自动填充）"
    },
    "deviceId": {
      "type": "string",
      "default": "",
      "description": "设备唯一标识（首次注册后自动填充）"
    },
    "connectionStatus": {
      "type": "string",
      "default": "",
      "description": "连接状态（自动更新）"
    }
  }
}