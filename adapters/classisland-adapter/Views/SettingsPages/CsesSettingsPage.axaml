<ci:SettingsPageBase x:Class="CsesCloudAdapter.Views.SettingsPages.CsesSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CsesCloudAdapter.Views.SettingsPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d" d:DataContext="{d:DesignInstance local:CsesSettingsViewModel}">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

            <!-- 连接状态（Tab 外）+ 合并后的“立即同步”按钮 -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="14" CornerRadius="8" Background="#20808080">
                    <StackPanel Spacing="4">
                        <TextBlock Text="连接状态" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DeviceInfo}" FontSize="12" Foreground="Gray" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Stretch" Spacing="8" MinWidth="120">
                    <Button Content="立即同步" Click="OnSyncNow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Content="断开连接" Click="OnDisconnect" HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsConnected}" />
                </StackPanel>
            </Grid>

            <TabControl>
                <!-- 连接 -->
                <TabItem Header="连接">
                    <StackPanel Spacing="12" Margin="4,12,4,4">
                        <!-- 已连接：隐藏注册组件，展示连接信息与断开入口 -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsConnected}">
                            <Border Padding="12" CornerRadius="8" Background="#20808080">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="设备已接入实例，档案与设置将自动同步。" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConnectedSummary}" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="如需更换实例，请先在下方断开连接，再填写新的注册码。" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 未连接：注册组件 -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsDisconnected}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="服务器地址" FontWeight="SemiBold" />
                                <TextBox Watermark="例如 https://cses.example.com" Text="{Binding ServerUrl}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="注册码" FontWeight="SemiBold" />
                                <TextBox Watermark="CSES-/EA2- 开头（在平台实例「设备列表」页面生成，仅首次绑定需要）"
                                         Text="{Binding EnrollmentCode}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="设备名称" FontWeight="SemiBold" />
                                <TextBox Watermark="留空则使用主机名（如：高一（3）班讲台机）" Text="{Binding DeviceName}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="保存设置" Click="OnSaveSettings" />
                                <Button Content="导入凭据" Click="OnImportCredentials" />
                                <Button Content="连接（注册设备）" Click="OnRegister" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                                       Text="提示：注册码仅在设备首次绑定时校验；也可以在平台生成注册码后点击「下载凭据」，再在此处一键导入。" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 档案同步 -->
                <TabItem Header="档案同步">
                    <StackPanel Spacing="12" Margin="4,12,4,4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="档案应用方式" FontWeight="SemiBold" />
                            <ComboBox SelectedIndex="{Binding ApplyModeIndex}">
                                <ComboBoxItem Content="热替换当前档案（立即生效）" />
                                <ComboBoxItem Content="写入档案文件（重启 / 切换档案后生效）" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="目标档案文件名（应用方式为「写入档案文件」时使用）" FontWeight="SemiBold" />
                            <TextBox Text="{Binding TargetProfileName}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="连接传输" FontWeight="SemiBold" />
                            <ComboBox SelectedIndex="{Binding TransportIndex}">
                                <ComboBoxItem Content="长轮询（REST，按服务器间隔拉取）" />
                                <ComboBoxItem Content="WebSocket（实时推送，断线自动回退长轮询）" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="轮询间隔（秒，实际以服务器限制为准）" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PollIntervalSeconds}" Watermark="30" />
                        </StackPanel>
                        <CheckBox Content="启用自动同步" IsChecked="{Binding AutoSyncEnabled}" />
                    </StackPanel>
                </TabItem>

                <!-- 通知 -->
                <TabItem Header="通知">
                    <StackPanel Spacing="12" Margin="4,12,4,4">
                        <CheckBox Content="显示平台广播提醒" IsChecked="{Binding ShowBroadcastNotifications}" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                                   Text="广播的显示时长由平台发送广播时指定，无需在此设置。" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
