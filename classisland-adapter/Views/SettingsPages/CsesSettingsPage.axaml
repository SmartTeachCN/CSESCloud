<ci:SettingsPageBase x:Class="CsesCloudAdapter.Views.SettingsPages.CsesSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CsesCloudAdapter.Views.SettingsPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d" d:DataContext="{d:DesignInstance local:CsesSettingsViewModel}">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="CSES Cloud 适配器" FontSize="22" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Foreground="Gray"
                       Text="将此 ClassIsland 接入 CSES Cloud 平台：从平台实例同步课表档案（科目 / 时间表 / 课表），并接收平台广播与设置下发。" />

            <!-- 状态 -->
            <Border Padding="14" CornerRadius="8" Background="#20808080">
                <StackPanel Spacing="4">
                    <TextBlock Text="连接状态" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DeviceInfo}" FontSize="12" Foreground="Gray" />
                </StackPanel>
            </Border>

            <!-- 服务器 -->
            <StackPanel Spacing="4">
                <TextBlock Text="服务器地址" FontWeight="SemiBold" />
                <TextBox Watermark="例如 https://cses.example.com" Text="{Binding ServerUrl}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="注册码" FontWeight="SemiBold" />
                <TextBox Watermark="EA2-xxxx（在平台实例「连接应用」页面生成，仅首次绑定需要）"
                         Text="{Binding EnrollmentCode}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="设备名称" FontWeight="SemiBold" />
                <TextBox Watermark="留空则使用主机名（如：高一（3）班讲台机）" Text="{Binding DeviceName}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="连接传输" FontWeight="SemiBold" />
                <ComboBox SelectedIndex="{Binding TransportIndex}">
                    <ComboBoxItem Content="长轮询（REST，兼容性最好）" />
                    <ComboBoxItem Content="WebSocket（实时推送，断线自动回退长轮询）" />
                </ComboBox>
            </StackPanel>

            <!-- 同步 -->
            <StackPanel Spacing="4">
                <TextBlock Text="档案应用方式" FontWeight="SemiBold" />
                <ComboBox SelectedIndex="{Binding ApplyModeIndex}">
                    <ComboBoxItem Content="热替换当前档案（立即生效）" />
                    <ComboBoxItem Content="写入档案文件（重启 / 切换档案后生效）" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="目标档案文件名（应用方式为「写入档案文件」时使用）" FontWeight="SemiBold" />
                <TextBox Text="{Binding TargetProfileName}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="轮询间隔（秒，实际以服务器限制为准）" FontWeight="SemiBold" />
                <TextBox Text="{Binding PollIntervalSeconds}" Watermark="300" />
            </StackPanel>

            <CheckBox Content="启用自动同步" IsChecked="{Binding AutoSyncEnabled}" />
            <CheckBox Content="显示平台广播提醒" IsChecked="{Binding ShowBroadcastNotifications}" />

            <StackPanel Spacing="4">
                <TextBlock Text="广播提醒时长（秒）" FontWeight="SemiBold" />
                <TextBox Text="{Binding BroadcastDurationSeconds}" Watermark="10" />
            </StackPanel>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button Content="保存设置" Click="OnSaveSettings" />
                <Button Content="导入凭据" Click="OnImportCredentials" />
                <Button Content="连接（注册设备）" Click="OnRegister" />
                <Button Content="立即同步" Click="OnSyncNow" />
                <Button Content="刷新状态" Click="OnRefreshStatus" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                       Text="提示：注册码仅在设备首次绑定时校验；绑定成功后凭证保存在插件配置目录（Config/Plugins/cloud.cses.classisland/credentials.json）。也可以在平台「连接应用」页面生成注册码后点击「下载凭据」，再在此处一键导入。档案同步支持 1.x / 2.x 两种 ClassIsland 时间格式。" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
