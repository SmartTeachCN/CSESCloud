{
  "name": "ea2-cses-cloud-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "module": "./dist/renderer/index.mjs",
  "examaware": {
    "apiVersion": 2,
    "displayName": "CSES Cloud 适配器",
    "description": "连接 CSES Cloud 云控平台，通过 REST API 轮询实现设备注册、命令下发和状态上报",
    "permissions": [
      "ui.contribute",
      "network.http",
      "network.local"
    ],
    "targets": {
      "main": "main.cjs",
      "renderer": "./dist/renderer/index.mjs"
    },
    "activation": {
      "rendererWindows": ["settings"]
    },
    "settings": {
      "namespace": "cses-cloud",
      "schema": "./schema.json"
    }
  },
  "dependencies": {
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.7.3",
    "vite": "^6.4.1"
  },
  "scripts": {
    "build": "vite build --config vite.renderer.config.ts",
    "dev": "vite build --watch --mode development --config vite.renderer.config.ts"
  }
}