{
  "plugin_key": "markdown_reader",
  "name": "Markdown 阅读器",
  "version": "1.0.0",
  "description": "官方 Markdown 阅读器：左侧实时预览 + 右侧源码，或全预览阅读；自带离线 Markdown 渲染（标题/列表/表格/任务列表/围栏代码/引用/链接图片），支持 Ctrl+S 保存与滚动同步。",
  "extensions": [
    "md",
    "markdown",
    "mdown"
  ],
  "icon": "asset:icon.png",
  "ribbon": [
    {
      "label": "视图",
      "tools": [
        { "id": "md-split", "label": "分栏", "icon": "ri-layout-column-line", "command": "md-mode-split" },
        { "id": "md-preview", "label": "全预览", "icon": "ri-eye-line", "command": "md-mode-preview" },
        { "id": "md-source", "label": "全源码", "icon": "ri-code-line", "command": "md-mode-source" }
      ]
    },
    {
      "label": "文件",
      "tools": [
        { "id": "md-save", "label": "保存", "icon": "ri-save-3-line", "command": "md-save" },
        { "id": "md-refresh", "label": "重新渲染", "icon": "ri-refresh-line", "command": "md-refresh" }
      ]
    }
  ],
  "status": "published",
  "developer_username": "system",
  "is_official": true,
  "created_at": "2026-10-30 22:45:00",
  "updated_at": "2026-10-30 22:45:00"
}
